IDENTIFIER   "console"                @ 1:1
DOT          "."                      @ 1:8
IDENTIFIER   "log"                    @ 1:9
LPAREN       "("                      @ 1:12
NUMBER       "123"                    @ 1:13
COMMA        ","                      @ 1:16
NUMBER       "12.5"                   @ 1:18
COMMA        ","                      @ 1:22
STRING       "\"hello\""              @ 1:24 value="hello"
COMMA        ","                      @ 1:31
STRING       "\"\""                   @ 1:33 value=""
RPAREN       ")"                      @ 1:35
SEMICOLON    ";"                      @ 1:36
EOF          ""                       @ 2:1
