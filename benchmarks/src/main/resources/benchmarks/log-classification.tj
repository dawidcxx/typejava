type UpstreamLog = {
  readonly service: string;
  readonly message: string;
  readonly level: number | null;
};

type Classification = {
  readonly service: string;
  readonly severity: string;
  readonly action: string;
  readonly priority: number;
};

type RuleSet = {
  classify: (this: RuleSet, log: UpstreamLog) => Classification;
};

function severityOf(level: number | null): string {
  if (level == null) {
    return "unknown";
  }

  if (level >= 5) {
    return "critical";
  }

  if (level >= 3) {
    return "warning";
  }

  return "info";
};

function basePriority(severity: string, service: string): number {
  if (severity == "critical") {
    return 3;
  }

  if (severity == "warning") {
    if (service == "billing") {
      return 2;
    }

    return 1;
  }

  if (severity == "info") {
    return 0;
  }

  return -1;
};

function actionOf(severity: string, priority: number, message: string): string {
  if (message == "card declined") {
    return "page";
  }

  if (severity == "critical") {
    return "page";
  }

  if (severity == "warning" && priority >= 2) {
    return "page";
  }

  if (severity == "warning") {
    return "ticket";
  }

  if (severity == "info") {
    return "log";
  }

  return "ignore";
};

const rules: RuleSet = {
  classify(this: RuleSet, log: UpstreamLog): Classification {
    const severity: string = severityOf(log.level);
    const priority: number = basePriority(severity, log.service);
    const action: string = actionOf(severity, priority, log.message);

    return {
      service: log.service,
      severity: severity,
      action: action,
      priority: priority
    };
  }
};

function serviceAt(index: number): string {
  const slot: number = index % 5;

  if (slot == 0) {
    return "billing";
  }

  if (slot == 1) {
    return "auth";
  }

  if (slot == 2) {
    return "cron";
  }

  if (slot == 3) {
    return "search";
  }

  return "checkout";
};

function levelAt(index: number): number | null {
  const slot: number = index % 7;

  if (slot == 0) {
    return null;
  }

  if (slot == 6) {
    return 5;
  }

  return slot;
};

function messageAt(index: number): string {
  const slot: number = index % 4;

  if (slot == 0) {
    return "timeout";
  }

  if (slot == 1) {
    return "card declined";
  }

  if (slot == 2) {
    return "login failed";
  }

  return "nothing to report";
};

function buildLogs(count: number): TjArray<UpstreamLog> {
  const logs: TjArray<UpstreamLog> = TjArray.create();
  let i: number = 0;

  while (i < count) {
    logs.add({
      service: serviceAt(i),
      message: messageAt(i),
      level: levelAt(i)
    });

    i = i + 1;
  }

  return logs;
};

function increment(counts: TjMap<string, number>, key: string): void {
  if (counts.containsKey(key)) {
    const current: number = counts.get(key);
    counts.put(key, current + 1);
  } else {
    counts.put(key, 1);
  }
};

function runWorkload(count: number): string {
  const logs: TjArray<UpstreamLog> = buildLogs(count);
  const severityCounts: TjMap<string, number> = TjMap.create();
  const actionCounts: TjMap<string, number> = TjMap.create();
  let critical: number = 0;
  let pageable: number = 0;
  let i: number = 0;

  while (i < logs.size()) {
    const log: UpstreamLog = logs.get(i);
    const result: Classification = rules.classify(log);

    increment(severityCounts, result.severity);
    increment(actionCounts, result.action);

    if (result.severity == "critical") {
      critical = critical + 1;
    }

    if (result.action == "page") {
      pageable = pageable + 1;
    }

    i = i + 1;
  }

  let warnings: number = 0;
  if (severityCounts.containsKey("warning")) {
    warnings = severityCounts.get("warning");
  }

  return "logs=" + logs.size()
    + " critical=" + critical
    + " warnings=" + warnings
    + " page=" + pageable
    + " severities=" + severityCounts.size()
    + " actions=" + actionCounts.size();
};

console.log(runWorkload(10000));
